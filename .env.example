# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL credentials for all services
DB_USERNAME=khoidev
DB_PASSWORD=khoicktv

# PostgreSQL port mapping
# DB_HOST_PORT: Port on your machine (for DBeaver, psql, etc.)
# DB_PORT: Internal Docker port (used by services) - DO NOT CHANGE
DB_HOST_PORT=5433
DB_PORT=5432

# ==================== KAFKA CONFIGURATION ====================
# Kafka broker configuration
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ==================== CLOUDFLARE R2 CONFIGURATION ====================
# Cloudflare R2 Storage credentials
# Get these from your Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here

# Public bucket URLs (optional - defaults provided in docker-compose.yml)
USER_AVATAR_PUBLIC_BUCKET_URL=https://pub-954e99f131cf4cc896de1ad360338682.r2.dev

# ==================== NOTES ====================
# 1. Copy this file to .env and fill in your actual credentials
# 2. Never commit the .env file to version control
# 3. The R2 credentials are required for file upload functionality
# 4. Database credentials have defaults but can be customized
# 5. Kafka host should remain 'kafka' when running in Docker Compose
